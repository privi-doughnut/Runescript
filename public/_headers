# Cache policy so deploys show up immediately.
# The HTML entry must always revalidate — otherwise the browser keeps an old
# index.html that points at a stale (hashed) JS bundle, and new deploys look
# invisible until a hard refresh. Hashed assets are content-addressed, so they're
# safe to cache forever.
/
  Cache-Control: no-cache
/index.html
  Cache-Control: no-cache
/assets/*
  Cache-Control: public, max-age=31536000, immutable
